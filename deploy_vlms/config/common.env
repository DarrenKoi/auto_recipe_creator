# Bind to localhost by default.
# If another internal machine must access this server, change this to the GPU server's company-internal IP
# and restrict inbound access with firewall/security-group rules.
HOST=127.0.0.1

DTYPE=bfloat16
GPU_MEMORY_UTILIZATION=0.80
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
TENSOR_PARALLEL_SIZE=1

# For 2-3 small models on one GPU, enable AUTO_TUNE per model env
# (keep commented here — each model/*.env activates it as needed).
# AUTO_TUNE_GPU_MEMORY_UTILIZATION=1
# COLOCATED_MODELS_PER_GPU=2
GPU_TOTAL_MEMORY_GIB=140
GPU_SHARED_RESERVE_GIB=8
GPU_PROCESS_RESERVE_GIB=4

# 인증 키는 여기 두지 않는다 - config/site.env 의 VLLM_API_KEY 하나를 serve_vlm.py 가
# --api-key 로 넘긴다. 같은 키가 Flask 프록시와 업로드에도 쓰인다.

# Security/offline controls
STRICT_OFFLINE=1
DISABLE_OUTBOUND_PROXIES=1
CREATE_VLLM_DO_NOT_TRACK_FILE=1
ALLOWED_MODEL_ROOT=/project/day/workSpace/itc-1stop-solution/itc-1stop-solution-gpu-image/pjt_shared_pool/models
