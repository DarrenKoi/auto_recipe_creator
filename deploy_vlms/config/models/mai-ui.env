MODEL_ID=/project/day/workSpace/itc-1stop-solution/itc-1stop-solution-gpu-image/data/models/MAI-UI-8B
SERVED_MODEL_NAME=mai-ui-8b
PORT=8002
GPU_ID=0
TRUST_REMOTE_CODE=1
LIMIT_MM_PER_PROMPT={"image": 1}
CHAT_TEMPLATE=
# Sole occupant of GPU 0 (ui-venus / ui-tars retired 2026-08-11).
# No co-location -> no auto-tune, no COLOCATED_MODELS_PER_GPU: u is used verbatim.
# 8B bf16 ~= 16GiB weights, so 0.85 of 140GiB is mostly KV headroom (harmless).
GPU_MEMORY_UTILIZATION=0.85
# Grounding calls are latency-bound (2-stage locator = 2 sequential calls),
# so the levers that matter are prefill headroom, not batch size.
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=16384
# 호스트 RAM 16GB 제약: 아래 두 값은 GPU 가 아니라 시스템 메모리를 쓴다.
#   --swap-space (기본 4GiB, pinned host mem) : V1 엔진은 preemption 을 recompute 로
#     처리하므로 사실상 미사용. 0.5 로 낮춰 pinned 예약을 줄인다.
#   --mm-processor-cache-gb (기본 4GiB, host) : 디코딩된 이미지 캐시 상한.
#     스크린샷은 매번 다르므로 캐시 적중이 거의 없다 -> 0 으로 끈다.
EXTRA_VLLM_ARGS=--swap-space 0.5 --mm-processor-cache-gb 0
