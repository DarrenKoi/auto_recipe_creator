MODEL_ID=/project/day/workSpace/itc-1stop-solution/itc-1stop-solution-gpu-image/data/models/PaddleOCR-VL-1.5
SERVED_MODEL_NAME=paddleocr-vl-1.5
PORT=8004
GPU_ID=1
TRUST_REMOTE_CODE=1
LIMIT_MM_PER_PROMPT={"image": 1}
CHAT_TEMPLATE=
# Tiny 0.9B model on GPU 1, sharing only with GOT-OCR (transformers, ~4GiB).
# mai-ui moved to GPU 0 (2026-08-11), so a little more room is available here.
GPU_MEMORY_UTILIZATION=0.20
MAX_MODEL_LEN=8192
MAX_NUM_SEQS=8
# 호스트 RAM 16GB 제약 (mai-ui.env 주석 참고). --swap-space 는 이 vLLM 에 없다.
EXTRA_VLLM_ARGS=--mm-processor-cache-gb 0
