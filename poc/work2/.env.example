# Private cloud Flask API root. Host root or `/api` root 모두 허용.
WORK2_FLASK_API_BASE_URL=http://itc-1stop-solution-gpu-image-webapp.aipp02.skhynix.com/api

# Primary VLM: UI-Venus
WORK2_VLM_SERVICE=ui-venus
WORK2_VLM_MODEL_NAME=ui-venus-1.5-8b

# OCR assist stage: PaddleOCR-VL
WORK2_OCR_PIPELINE_ENABLED=true
WORK2_OCR_SERVICE=paddleocr-vl-1.5
WORK2_OCR_MODEL_NAME=paddleocr-vl-1.5

# 필요 시 직접 route base URL 지정 가능
# WORK2_VLM_API_URL=http://itc-1stop-solution-gpu-image-webapp.aipp02.skhynix.com/api/vlm_serve/ui-venus
# WORK2_OCR_API_URL=http://itc-1stop-solution-gpu-image-webapp.aipp02.skhynix.com/api/vlm_serve/paddleocr-vl-1.5

# 필요 시 proxy 인증 key 사용
# WORK2_VLM_API_KEY=
# WORK2_OCR_API_KEY=
